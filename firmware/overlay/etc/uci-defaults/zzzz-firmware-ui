#!/bin/sh
set -eu
uci set luci.main.lang='zh_cn'
uci set luci.main.mediaurlbase='/luci-static/argon'
uci commit luci
# Components ship without user subscriptions or private network settings.
for service in nikki momo honk easytier msd_lite lucky; do
    [ ! -x "/etc/init.d/$service" ] || "/etc/init.d/$service" disable
done
exit 0
