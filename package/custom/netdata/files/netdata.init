#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
	mkdir -p /var/cache/netdata /var/lib/netdata/cloud.d /var/log/netdata
	procd_open_instance
	procd_set_param command /usr/sbin/netdata -D -c /etc/netdata/netdata.conf
	procd_set_param file /etc/netdata/netdata.conf
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
